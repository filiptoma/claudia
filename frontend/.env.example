# Template — copy to the gitignored env file for the database you want:
#   cp .env.example .env.development   # dev DB  (npm run dev / build:dev)
#   cp .env.example .env.production    # prod DB (npm run build / dev:live)
# The publishable key is browser-safe (RLS protects the data); never use the sb_secret_ key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
